{
  "name": "@ai-note/desktop",
  "version": "0.3.0",
  "description": "INote desktop app - local-first note-taking & file management with built-in version control",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "unset ELECTRON_RUN_AS_NODE && electron-vite dev",
    "build": "electron-vite build",
    "preview": "unset ELECTRON_RUN_AS_NODE && electron-vite preview",
    "rebuild": "electron-rebuild",
    "postinstall": "electron-rebuild",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "@AInote/feedback-sdk": "workspace:*",
    "@abandonware/bleno": "^0.6.2",
    "@ai-note/shared-types": "workspace:*",
    "@ai-sdk/anthropic": "^3.0.44",
    "@ai-sdk/openai-compatible": "^2.0.30",
    "@blocknote/core": "^0.46.2",
    "@blocknote/mantine": "^0.46.2",
    "@blocknote/react": "^0.46.2",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@excalidraw/excalidraw": "^0.18.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/websocket": "^11.2.0",
    "@mantine/core": "^8.3.14",
    "@mantine/hooks": "^8.3.14",
    "ai": "^6.0.86",
    "better-sqlite3": "^11.8.1",
    "bonjour-service": "^1.3.0",
    "chokidar": "^4.0.3",
    "codemirror": "^6.0.1",
    "diff": "^7.0.0",
    "electron-updater": "^6.8.3",
    "fastify": "^5.7.4",
    "flexsearch": "^0.7.43",
    "gray-matter": "^4.0.3",
    "isomorphic-git": "^1.27.2",
    "marked": "^17.0.2",
    "pdfjs-dist": "^5.4.296",
    "puppeteer-core": "^24.37.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.3.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^13.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.71",
    "@anthropic-ai/claude-code": "^2.1.69",
    "@anthropic-ai/sdk": "^0.78.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "^4.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^6.0.0",
    "@types/marked": "^6.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.18.0",
    "nan": "^2.25.0",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^3.0.4"
  },
  "build": {
    "appId": "com.inote.app",
    "productName": "INote",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "generic",
      "url": "http://releases.sspprriinngg.cn"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "!**/*.map",
      "!**/*.map.js",
      "!**/README.md",
      "!**/README",
      "!**/readme.md",
      "!**/CHANGELOG.md",
      "!**/CHANGELOG",
      "!**/HISTORY.md",
      "!**/LICENSE",
      "!**/LICENSE.md",
      "!**/LICENSE.txt",
      "!**/license",
      "!**/test/**",
      "!**/tests/**",
      "!**/__tests__/**",
      "!**/*.test.js",
      "!**/*.spec.js",
      "!**/docs/**",
      "!**/example/**",
      "!**/examples/**",
      "!**/node_modules/pdfjs-dist/legacy/**",
      "!**/node_modules/react-icons/**",
      "!**/node_modules/@excalidraw/excalidraw/dist/dev/**",
      "!**/node_modules/@emoji-mart/data/sets/1/**",
      "!**/node_modules/@emoji-mart/data/sets/2/**",
      "!**/node_modules/@emoji-mart/data/sets/3/**",
      "!**/node_modules/@emoji-mart/data/sets/4/**",
      "!**/node_modules/@emoji-mart/data/sets/5/**",
      "!**/node_modules/@emoji-mart/data/sets/11/**",
      "!**/node_modules/@emoji-mart/data/sets/12/**",
      "!**/node_modules/@emoji-mart/data/sets/12.1/**",
      "!**/node_modules/@emoji-mart/data/sets/13/**",
      "!**/node_modules/@emoji-mart/data/sets/13.1/**",
      "!**/node_modules/@emoji-mart/data/sets/14/**",
      "!**/node_modules/mermaid/dist/mermaid.js"
    ],
    "icon": "resources/icon.png",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.icns",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
